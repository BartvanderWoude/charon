{
	"name": "Rust",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
	"features": {
		"ghcr.io/devcontainers/features/rust:1": {
			"profile": "default"
		}
	},
	"customizations": {
        "vscode":{
            "settings": {
				"[rust]": {
					"editor.formatOnSave": true
				},
				"[prolog]": {
					"executablePath": "scryer-prolog"
				}
			}
		}
	},
	"onCreateCommand": "sudo apt update && sudo apt install pkg-config && cargo install --locked --git https://github.com/mthom/scryer-prolog.git"
}